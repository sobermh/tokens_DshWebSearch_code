{
    "name":  "tokens-dsh-web-search",
    "version":  "0.2.3",
    "description":  "Locally maintained web search plugin for DeepSeek Harness with free and API-backed providers.",
    "tokenscowork": {
        "displayName": {
            "zh-CN": "TokensCowork 联网搜索",
            "en-US": "TokensCowork Web Search"
        },
        "summary": {
            "zh-CN": "为 web_search 提供免费及 API 搜索引擎、自动回退、时间过滤和平台搜索。",
            "en-US": "Free and API-backed engines for web_search with automatic fallback, time filtering, and platform search."
        }
    },
    "type":  "module",
    "scripts":  {
                    "test":  "node test/run-test-cases.mjs",
                    "test:cases":  "node test/run-test-cases.mjs",
                    "check:host":  "node scripts/check-host-contracts.mjs"
                },
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/hedged-race.js",
                  "lib/client.js",
                  "cordis.patch.yml"
              ],
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "web-search",
                     "duckduckgo",
                     "bing",
                     "tavily",
                     "exa",
                     "keenable",
                     "perplexity",
                     "search",
                     "free"
                 ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/sobermh/tokens_DshWebSearch_code.git"
                   },
    "publishConfig":  {
                          "registry":  "https://npm.tokensapi.ai/"
                      },
    "engines":  {
                    "node":  ">=20.3.0"
                },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.4"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-settings":  "\u003e=0.1.0-rc.6 \u003c1.0.0-0",
                             "@deepseek-ai/dsh-tools":  "\u003e=0.1.0-rc.6 \u003c1.0.0-0"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-settings":  {
                                                                   "optional":  true
                                                               },
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            }
                             },
    "devDependencies":  {
                            "@deepseek-ai/dsh-settings":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-tools":  "0.2.1-rc.2"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime"
                                          ],
                               "platform":  "web"
                           }
            }
}
